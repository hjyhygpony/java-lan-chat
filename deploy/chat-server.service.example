[Unit]
Description=Experiment 4 Java Chat Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=chat
WorkingDirectory=/opt/exp4-chat
ExecStart=/usr/bin/java -cp /opt/exp4-chat/build com.cncd.ch04.server.MainServer 3500 /opt/exp4-chat/data 0.0.0.0
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
